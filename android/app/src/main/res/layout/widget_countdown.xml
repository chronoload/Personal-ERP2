<?xml version="1.0" encoding="utf-8"?>
<!-- 倒计时小组件（4×2）：任务名 + 目标时间 + 秒级倒计时 + 状态/开始按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cd_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="下一个任务"
            android:textColor="#202631"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cd_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00"
            android:textColor="#6B7482"
            android:textSize="11sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/cd_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:shadowColor="#1A4A7FBF"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="#202631"
        android:textSize="34sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/cd_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_bar"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cd_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="距离开始还有 —"
            android:textColor="#6B7482"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/cd_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_add_bg"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="重置"
            android:textColor="#6B7482"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cd_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_add_bg"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:text="开始"
            android:textColor="#4A7FBF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 等待队列：接下来还有哪些已排期任务（高度不足时按 widget 尺寸自动隐藏） -->
    <View
        android:id="@+id/cd_queue_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#E5E8EE"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cd_queue_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:text="接下来"
        android:textColor="#8A93A3"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cd_queue_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/cd_queue_time1"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:textColor="#6B7482"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cd_queue_title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#4A5260"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cd_queue_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/cd_queue_time2"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:textColor="#6B7482"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cd_queue_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#4A5260"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cd_queue_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/cd_queue_time3"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:textColor="#6B7482"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cd_queue_title3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#4A5260"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
