<?xml version="1.0" encoding="utf-8"?>
<!-- 锁屏 / 亮屏开屏页：整页展示今日日程，可一键添加今日活动；背景深色，弱光下不刺眼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12161F"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/lock_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="今日日程"
        android:textColor="#F0F2F5"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#9AA6B8"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lock_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="今天还没有安排"
            android:textColor="#8A93A3"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/lock_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E8EBF0"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/lock_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E8EBF0"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/lock_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E8EBF0"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/lock_row4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E8EBF0"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/lock_row5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#E8EBF0"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/lock_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#9AA6B8"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lock_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_add_bg"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="＋ 添加今日日程"
        android:textColor="#8FB8E8"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lock_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="解锁查看"
            android:textColor="#9AA6B8"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lock_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="关闭"
            android:textColor="#9AA6B8"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
