<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面直接记一条需求：小弹窗，不进入主程序 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="记一条需求"
        android:textColor="#1F2430"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dq_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="像顾客点菜：写下他要什么，之后在应用里入列。"
        android:textColor="#8A93A3"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="来源"
        android:textColor="#4A5260"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/dq_requester"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/dq_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="他要什么（原话即可）"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:textColor="#1F2430" />

    <EditText
        android:id="@+id/dq_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="备注 / 我的判断（可空）"
        android:inputType="text"
        android:textColor="#1F2430" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dq_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消" />

        <Button
            android:id="@+id/dq_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="记下" />
    </LinearLayout>

</LinearLayout>
