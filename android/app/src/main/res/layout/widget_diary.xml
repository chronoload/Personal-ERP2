<?xml version="1.0" encoding="utf-8"?>
<!-- 日记小组件：顶部 ‹ 日期 ›，正文 + 底部提示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_diary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_diary_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="‹"
            android:textColor="#9AA3B2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_diary_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="今天"
            android:textColor="#9AA3B2"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_diary_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="›"
            android:textColor="#9AA3B2"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_diary_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="9"
        android:text=""
        android:textColor="#202631"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_diary_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text=""
        android:textColor="#9AA3B2"
        android:textSize="10sp" />

</LinearLayout>
